modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = "https://uxpkqqcgkrmwylbwucjz.supabase.co"
RENTLY_PUBLIC_URL = "https://rently-landing-page.replit.app"

[userenv.development]
RENTLY_STRIPE_ACCOUNT_ID = "acct_1UcGzVDQ886gcL7w"

[userenv.production]
RENTLY_STRIPE_ACCOUNT_ID = "acct_1UcGzVDQ886gcL7w"
